# Copia este archivo a .env.development.local (ignorado por git). Todo lo que empieza con VITE_
# queda visible en el navegador: NUNCA pongas aquí claves privadas ni contraseñas.

# Probar contra los emuladores locales de Firebase (solo desarrollo)
# VITE_USE_EMULATOR=true

# Firebase App Check (reCAPTCHA v3): clave PÚBLICA del sitio. Ver notificaciones/README.md
# y SEGURIDAD.md. Si no se define, App Check no se activa.
# VITE_APPCHECK_SITE_KEY=
